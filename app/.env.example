# Copia este archivo a .env.local (local) y carga las mismas variables en Vercel → Settings → Environment Variables.
# Sin NEXT_PUBLIC_SUPABASE_* la app corre en MODO DEMO (datos de Grupo Andes en memoria + localStorage).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co   # sólo el origen, sin /rest/v1/
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon / public key (segura en el navegador, RLS protege los datos)
SUPABASE_SERVICE_ROLE_KEY=           # service_role key · SÓLO servidor (cron de recordatorios). Nunca en NEXT_PUBLIC_.

# --- App ---
NEXT_PUBLIC_APP_URL=https://www.metisalign.mx   # dominio principal · se usa en enlaces de correos, OG y redirecciones

# --- Correo transaccional (Resend · https://resend.com) ---
RESEND_API_KEY=                      # sin esto los recordatorios se registran en consola (dry-run)
EMAIL_FROM=mêtis <recordatorios@metisalign.mx>   # remitente verificado en Resend

# --- Cron de Vercel ---
CRON_SECRET=                         # cadena aleatoria larga; Vercel la manda como Authorization: Bearer

# Avisos al celular (Web Push). Generar con: npx web-push generate-vapid-keys
# Avisos al celular: las llaves VAPID las genera el servidor y las guarda en ceo.server_secrets (migración 0023).
# No las pongas aquí salvo que quieras rotarlas desde Vercel; nunca compartas la privada.
VAPID_SUBJECT=mailto:hola@metis.ceo
# Noticias internacionales GDELT en el radar (opcional, 1 para activar)
WORLD_GDELT=
